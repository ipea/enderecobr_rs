# Copie para .env (o Makefile le este arquivo quando ele existe).
API_URL=...
API_KEY=...
API_MODEL=...

# Opcionais
SEARX_URL=             # sem ela a busca web fica indisponível
API_TOOLS_STRICT=1     # manda `strict: true` no schema das tools
TIMEOUT_SQL=15         # teto de segundos por query da LLM
